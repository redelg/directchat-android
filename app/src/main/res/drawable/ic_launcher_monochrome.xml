<?xml version="1.0" encoding="utf-8"?>
<!--
  Mensaji adaptive icon — monochrome layer (Android 13+ themed icons)
  Single-color silhouette of the Nodes mark. System tints this at runtime,
  so all paths must be white (#FFFFFF). No coral, no fills besides white.

  Geometry matches foreground (cx=36/72) so themed icons read the same
  silhouette as the colored version. Receiver is a ring (not a fill) so
  the two nodes stay distinguishable when monochromed at small sizes.
  Removed android:tint on root — the launcher applies the system tint
  for themed icons; setting it locally fights that and was causing the
  monochrome to render with the wrong color in some launchers.

  Drop in: app/src/main/res/drawable/ic_launcher_monochrome.xml
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- connector -->
    <path
        android:pathData="M 48,54 L 60,54"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <!-- sender: solid  cx=36 cy=54 r=12 -->
    <path
        android:pathData="M 24,54 a 12,12 0 1,0 24,0 a 12,12 0 1,0 -24,0 Z"
        android:fillColor="#FFFFFF" />

    <!-- receiver: ring  cx=72 cy=54 r=12, stroke 4.5 -->
    <path
        android:pathData="M 60,54 a 12,12 0 1,0 24,0 a 12,12 0 1,0 -24,0 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5" />
</vector>
